# Supabase project URL, e.g. https://your-project-ref.supabase.co
# Find it in the Supabase dashboard under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (safe to expose to the browser — access is
# governed by Row Level Security, not key secrecy). Use the publishable
# key (starts with sb_publishable_) from Project Settings > API, not the
# service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here
